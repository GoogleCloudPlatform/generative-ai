# Google Cloud project ID (leave empty or placeholder to resolve from ADC).
GOOGLE_CLOUD_PROJECT="[your-project-id]"

# Google Cloud region for the Gemini platform Endpoint and Model Registry.
GOOGLE_CLOUD_REGION="us-central1"

# Display name and ID for the Gemini platform Endpoint and Model.
DIFFUSIONGEMMA_ENDPOINT_NAME="diffusiongemma-vllm"

# Hugging Face repository ID for DiffusionGemma weights.
DIFFUSIONGEMMA_MODEL_ID="nvidia/diffusiongemma-26B-A4B-it-NVFP4"

# Short OpenAI-compatible model alias passed to vLLM --served-model-name.
DIFFUSIONGEMMA_SERVED_MODEL_NAME="diffusiongemma-26b"

# Optional full Artifact Registry container URI override for vLLM.
VLLM_IMAGE_URI=""

# Optional Hugging Face access token if pulling gated repositories.
HF_TOKEN=""
