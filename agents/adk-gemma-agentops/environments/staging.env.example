# Stage 2 (AgentOps Level 1): Cloud Run Staging Gate (staging branch)
# Serverless Gemini Agent Platform Gemma 4 MaaS ($0 idle, pay-per-token on global endpoint)
AGENT_ENV=staging
CLOUD_RUN_SERVICE=gemma-agent-staging
DATA_GOVERNANCE_TIER=anonymized_staging_snapshot
GEMMA_MAAS_MODEL_ID=google/gemma-4-26b-a4b-it-maas
GOOGLE_GENAI_USE_VERTEXAI=1
MAX_INSTANCES=1
MIN_INSTANCES=1
SESSION_TYPE=memory
SLO_P95_SECONDS=35.0
SMOKE_USERS=5
USE_MAAS=1
