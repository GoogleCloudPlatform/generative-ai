# Stage 3 (AgentOps Level 2): Cloud Run Production + Gemini Agent Platform MaaS (main branch)
# Serverless PayGo default (add Gemini Agent Platform Provisioned Throughput for reserved QPS)
AGENT_ENV=prod
CLOUD_RUN_SERVICE=gemma-agent-prod
DATA_GOVERNANCE_TIER=live_production_data
GEMMA_MAAS_MODEL_ID=google/gemma-4-26b-a4b-it-maas
MAX_INSTANCES=20
MIN_INSTANCES=1
OTEL_TO_CLOUD=true
SESSION_TYPE=cloud_sql
SLO_P95_SECONDS=35.0
TARGET_PEAK_USERS=5
TRACE_TO_CLOUD=true
USE_MAAS=1
