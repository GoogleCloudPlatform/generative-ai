# ============================================================================
# Sample Local Environment (.env.example -> copy to .env for Stage 1 Mac Dev)
# ============================================================================
AGENT_ENV=dev
DATA_GOVERNANCE_TIER=synthetic_fixtures_only
HF_TOKEN=replace_with_your_huggingface_token
SESSION_TYPE=memory

# Local Stage 1 model server (model_serving/gemma_server.py)
GEMMA_API_KEY=local-no-key-required
GEMMA_ENGINE=mlx
GEMMA_MODEL_ID=mlx-community/gemma-3-12b-it-4bit
GEMMA_SERVER_URL=http://127.0.0.1:8080/v1

# Stage 2 / Stage 3 (Serverless Gemini Agent Platform Gemma 4 MaaS on global endpoint)
GEMMA_MAAS_MODEL_ID=google/gemma-4-26b-a4b-it-maas
USE_MAAS=0
# GCP_REGION=us-west1
# GOOGLE_CLOUD_PROJECT=staging-project
