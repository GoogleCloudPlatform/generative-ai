# GCP Configuration
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Model Configuration
# MODEL_NAME is the default (flash) model; GEMINI_PRO_MODEL is used for
# higher-accuracy inference and learning steps.
MODEL_NAME=gemini-3.5-flash
GEMINI_PRO_MODEL=gemini-3.5-pro

# Rate Limiting (seconds between API calls)
# Increase if hitting quota limits, decrease if you have higher quota.
API_CALL_DELAY_SECONDS=1.0
