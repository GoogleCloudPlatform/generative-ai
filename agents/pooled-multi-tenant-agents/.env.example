# Optional live Gemini mode via google-genai (defaults to 0 for local deterministic demo)
CYMBAL_LIVE_GEMINI=0
GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=true
# Optional control-plane admin token for POST /api/v1/tenants/{tenant_id}/offboard
CYMBAL_PLATFORM_ADMIN_TOKEN=replace-with-strong-secret
