# Google Cloud configuration for all agents and pipeline scripts.
# Copy to `.env` and fill in your own values:
#   cp .env.example .env

# Route the google-genai SDK through Google Cloud (not the public Gemini API).
GOOGLE_GENAI_USE_VERTEXAI=TRUE

# Your Google Cloud project ID.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Google Cloud location. Use `global` for Gemini 3.x models; Gemini 2.5 models
# are served from regional endpoints (e.g. `us-central1`).
GOOGLE_CLOUD_LOCATION=global
