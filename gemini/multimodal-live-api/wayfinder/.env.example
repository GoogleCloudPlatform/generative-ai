# --- Google Cloud ------------------------------------------------------
# If unset, picked up from `gcloud config get-value project`.
GOOGLE_CLOUD_PROJECT=your-project-id
# Vertex AI location for model calls. The "us" multi-region serves both
# Gemini 3.8 Live (voice) and Gemini 3.8 Flash (text).
GOOGLE_CLOUD_LOCATION=us
# ADK / google-genai use Vertex AI with Application Default Credentials.
GOOGLE_GENAI_USE_VERTEXAI=TRUE

# --- Models ------------------------------------------------------------
# Voice (Gemini Live API).
GEMINI_MODEL=gemini-3.8-live
# Text (ADK runner).
GEMINI_TEXT_MODEL=gemini-3.8-flash
# Optional: try Gemini 3.8 Live Extended Thinking in a project with access.
# The voice agent switches to async tools and a thinking level automatically,
# and falls back to GEMINI_FALLBACK_MODEL if the session can't start.
# GEMINI_MODEL=gemini-3.8-live-extended-thinking
# GEMINI_FALLBACK_MODEL=gemini-3.8-live
# LIVE_THINKING_LEVEL=MEDIUM

# --- Live API options (voice) -----------------------------------------
# LIVE_VOICE=Aoede                    # prebuilt output voice
# LIVE_PROACTIVE_AUDIO=true           # ignore speech not addressed to the agent
# LIVE_AFFECTIVE_DIALOG=false         # adapt tone to the user's emotion
# LIVE_CONTEXT_COMPRESSION=true       # sliding window for long sessions
# LIVE_ASYNC_SEARCH=true              # knowledge search as a NON_BLOCKING tool
# Optional features are dropped automatically if the model rejects them.

# --- Server ------------------------------------------------------------
HOST=0.0.0.0
PORT=8080
# CORS allowlist of full origins, e.g. https://acme.com,https://www.acme.com
ALLOWED_ORIGINS=*
# RELOAD=1                            # uvicorn auto-reload (make run sets this)

# --- Grounding (Vertex AI Search) --------------------------------------
# Map a grounding key (the widget's data-tenant, or the page hostname) to an
# engine. Generate entries with scripts/provision_docs.py or provision_engine.py.
VERTEX_SEARCH_ENGINES={}
# Example:
# VERTEX_SEARCH_ENGINES={"acme-cloud": "projects/PROJECT_NUMBER/locations/global/collections/default_collection/engines/wf-acme-cloud-docs"}

# --- Access control (off for local development) ------------------------
AUTH_ENABLED=false
# SELF_ORIGIN=wayfinder-abc123-uc.a.run.app
# API_KEYS={"wf_dev_key":{"name":"Local Dev","origins":["*"]}}
# API_KEYS_FILE=api_keys.json
