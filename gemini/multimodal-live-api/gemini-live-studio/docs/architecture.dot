// Render: dot -Tpng -Gdpi=144 docs/architecture.dot -o docs/architecture.png
digraph Architecture {
  graph [bgcolor="#ffffff", fontname="Helvetica", fontsize=12, pad=0.4, nodesep=0.45, ranksep=0.7, rankdir=TB];
  node  [shape=box, style="rounded,filled", color="#c2c6d5", fillcolor="#ffffff", fontcolor="#191b22", fontname="Helvetica", fontsize=11, margin="0.18,0.10"];
  edge  [color="#727785", fontcolor="#424753", fontname="Helvetica", fontsize=9, penwidth=1.3];

  subgraph cluster_browser {
    label="Browser: Lit web components (Vite, Tailwind)"; style="rounded,filled"; color="#c2c6d5"; fillcolor="#f2f3fd"; fontcolor="#424753";
    Setup   [label="<avatar-setup> / <live-setup>\npreset, upload, webcam or prompt avatar;\nvoice, tools, grounding context"];
    Session [label="<avatar-session> / <live-session>\nLiveSocketController\nmic (AudioWorklet, 16 kHz PCM) and 1 FPS camera/screen up;\nfMP4 (MediaSource) or PCM (Web Audio) down; transcripts", color="#4285f4", penwidth=2];
    Settings [label="<app-settings>\nmodels, VAD, theme\n(localStorage)"];
    Settings -> Setup [style=dashed, label="defaults"];
    Setup -> Session [label="connect"];
  }

  subgraph cluster_server {
    label="Go server (single binary, serves frontend/dist)"; style="rounded,filled"; color="#c2c6d5"; fillcolor="#f2f3fd"; fontcolor="#424753";
    Guard  [label="origin policy, size limits,\ninput validation"];
    Live   [label="/ws (avatar video), /ws/live (audio)\nliveSession: receiveLoop, clientLoop,\nsingle shutdown(); greeting, barge-in,\ngraceful goodbye, 10-minute cap", color="#4285f4", penwidth=2];
    Images [label="/api/generate-avatar (9:16, 2K)\n/api/describe-image"];
    Config [label="/api/config\nmodel and location allowlists"];
    Guard -> Live; Guard -> Images;
  }

  subgraph cluster_cloud {
    label="Google Cloud"; style="rounded,filled"; color="#c2c6d5"; fillcolor="#f2f3fd"; fontcolor="#424753";
    LiveAPI  [label="Gemini Live API\n(gemini-3.8-live)"];
    ImageAPI [label="Gemini image models\n(gemini-3.1-flash-image)"];
  }

  Session -> Guard [label="WebSocket: JSON + base64 media up,\nbinary media down"];
  Setup -> Guard [label="HTTPS"];
  Settings -> Config [label="HTTPS"];
  Live -> LiveAPI [label="Bidi WebSocket\n(ADC credentials, Google Gen AI SDK)"];
  Images -> ImageAPI [label="GenerateContent"];
}
