# Prism configuration. Copy to `.env` (git-ignored) and fill in ONE backend.
#
#   cp .env.example .env
#
# Prism auto-detects which backend to use: if GOOGLE_API_KEY is set it uses the
# Gemini API, otherwise it uses Gemini Enterprise Agent Platform with GOOGLE_CLOUD_PROJECT. Variables
# you export in your shell take precedence over this file.

# ---------------------------------------------------------------------------
# Option A — Gemini API (Google AI Studio). Quickest way to start.
# Create a key at https://aistudio.google.com/apikey
# ---------------------------------------------------------------------------
# GOOGLE_API_KEY=your-api-key-here

# ---------------------------------------------------------------------------
# Option B — Gemini Enterprise Agent Platform.
# Requires the `aiplatform.googleapis.com` API enabled on the project and local credentials:
#   gcloud auth application-default login
#   gcloud services enable aiplatform.googleapis.com --project=YOUR_PROJECT_ID
# ---------------------------------------------------------------------------
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=global

# Force a backend explicitly (otherwise it is inferred from the two above):
# GOOGLE_GENAI_USE_VERTEXAI=true

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# The one model that runs every stage of the pipeline.
# https://ai.google.dev/gemini-api/docs/models
# PRISM_MODEL=gemini-3.7-flash

# How many research angles run in parallel (each is one grounded search).
# PRISM_MAX_WORKERS=5

# Which generation mode the UI starts on: fast | balanced | freeform
# PRISM_DEFAULT_MODE=balanced

# Where the local server listens (make demo overrides these).
# PRISM_HOST=127.0.0.1
# PRISM_PORT=8040
