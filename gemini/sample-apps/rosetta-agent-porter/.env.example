# Rosetta configuration. Copy to `.env` (git-ignored) and fill in ONE backend.
#
#   cp .env.example .env
#
# Rosetta auto-detects which backend to use: if GOOGLE_API_KEY is set it uses the
# Gemini API, otherwise it uses Vertex AI with GOOGLE_CLOUD_PROJECT. Variables you
# export in your shell take precedence over this file.

# ---------------------------------------------------------------------------
# Option A — Gemini API (Google AI Studio). Quickest way to start.
# Create a key at https://aistudio.google.com/apikey
# ---------------------------------------------------------------------------
# GOOGLE_API_KEY=your-api-key-here

# ---------------------------------------------------------------------------
# Option B — Vertex AI (Gemini Enterprise Agent Platform).
# Requires the Vertex AI API enabled on the project and local credentials:
#   gcloud auth application-default login
#   gcloud services enable aiplatform.googleapis.com --project=YOUR_PROJECT_ID
# ---------------------------------------------------------------------------
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=global

# Force a backend explicitly (otherwise it is inferred from the two above):
# GOOGLE_GENAI_USE_VERTEXAI=true

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# The model that runs every stage of the pipeline.
# https://ai.google.dev/gemini-api/docs/models
# ROSETTA_MODEL=gemini-3.7-flash

# Where cloned repos and generated projects are written (default: ./workspace).
# ROSETTA_WORKSPACE=/tmp/rosetta-workspace

# NOTE: do not set ROSETTA_PORT / ROSETTA_PORTED_PORT here if you use
# `make demo`, which assigns free ports itself. Defaults live in serve.py
# (8030 for the cockpit, 8060 for the ported agent's api_server).
