GCP_PROJECT_ID=your-project-id
GCP_REGION=us-central1
GEMINI_LIVE_API_URL=wss://us-central1-aiplatform.googleapis.com/ws/google.cloud.aiplatform.v1.LlmBidiService/BidiGenerateContent

# leave empty to use application default credentials
GEMINI_BEARER_TOKEN=

ENABLE_AVATAR=true
AVATAR_NAME=Kira
VOICE_NAME=Aoede

# vertex (same project and credentials) or gemini (uses GEMINI_API_KEY)
GENMEDIA_BACKEND=vertex
IMAGE_MODEL=gemini-nano-banana-2.1
IMAGE_MODEL_LOCATION=global
VIDEO_MODEL=gemini-omni-1.2-flash
VIDEO_MODEL_LOCATION=global
VIDEO_RESOLUTION=720p
VIDEO_TIMEOUT_SECONDS=600
SCENE_MODEL=gemini-4-argon
SCENE_MODEL_LOCATION=global
# template: the model writes only the scene-specific code (faster). free: it writes the whole page
SCENE_MODE=template
# optional, low or high: less reasoning before the model writes a scene, so it comes back sooner
# SCENE_THINKING_LEVEL=low
# on: scenes prepared in advance with prewarm_scenes.py open instantly. off: every scene is generated
SCENE_LIBRARY=off
# reads the camera frame before the image model marks it up
READER_MODEL=gemini-3.8-flash
# reads a loaded research paper and answers questions about it
PAPER_MODEL=gemini-3.8-flash

PORT=8080
# Model that looks a paper up with Google Search. Defaults to PAPER_MODEL.
# SEARCH_MODEL=gemini-3.8-flash
# SEARCH_MODEL_LOCATION=global

# What the app opens on: "learning" (general tutor) or "research" (papers first).
DEMO_PRESET=learning
# Name shown in the header and the browser tab.
# APP_NAME=VoxPlore
# on: the tutor also shows images and scenes on its own while it explains. Can be switched in the app.
PROACTIVE_MODE=off
